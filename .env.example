
# TyposquatShield environment configuration

# Backend API address used by the dashboard.
# Local Docker Compose overrides this with http://api:8000.
TPS_API_URL=http://127.0.0.1:8000

# Local SQLite database path.
# Used for local development only.
TPS_DATABASE_PATH=data/runtime/typosquatshield.db

# Cloud PostgreSQL connection.
# Set DATABASE_URL in the cloud hosting environment.
# Do not configure TPS_DATABASE_PATH alongside it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional application configuration
PYTHONUNBUFFERED=1
